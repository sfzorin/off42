    "marks_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسم فقط: وضع العلامة لا يمنح أي شهادة. اتبع قواعد الاستخدام الخاصة بكل علامة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Grafik: Ein platziertes Zeichen zertifiziert nichts. Beachte die Nutzungsregeln des jeweiligen Zeichens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Artwork only: placing a mark certifies nothing. Follow each mark's own rules of use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo es un gráfico: colocar una marca no certifica nada. Sigue las normas de uso propias de cada marca."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Artwork lang: walang sine-certify ang paglalagay ng mark. Sundin ang sariling patakaran sa paggamit ng bawat mark."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Graphisme uniquement : apposer un marquage ne certifie rien. Respectez les règles d'utilisation propres à chaque marquage."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak grafika: egy jelölés elhelyezése semmit sem tanúsít. Tartsd be az egyes jelölések saját használati szabályait."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya gambar: menempatkan tanda tidak menyertifikasi apa pun. Ikuti aturan penggunaan masing-masing tanda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo grafica: apporre una marcatura non certifica nulla. Segui le regole d'uso di ciascuna marcatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図柄のみです。マークを配置しても何かが認証されるわけではありません。各マークの使用規則に従ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래픽일 뿐입니다. 마크를 넣는다고 인증되는 것은 없습니다. 각 마크의 사용 규정을 따르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafik sahaja: meletakkan tanda tidak mensijilkan apa-apa. Ikut peraturan penggunaan setiap tanda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko grafika: umieszczenie znaku niczego nie certyfikuje. Przestrzegaj zasad użycia każdego znaku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas a arte: inserir uma marca não certifica nada. Siga as regras de uso de cada marca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только графика: размещение знака ничего не сертифицирует. Соблюдайте правила применения каждого знака."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นเพียงภาพกราฟิก การวางเครื่องหมายไม่ได้รับรองสิ่งใด โปรดปฏิบัติตามกฎการใช้งานของแต่ละเครื่องหมาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca çizim: bir işaret yerleştirmek hiçbir şeyi sertifikalandırmaz. Her işaretin kendi kullanım kurallarına uyun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ là hình vẽ: chèn dấu không có nghĩa là được chứng nhận. Hãy tuân theo quy định sử dụng riêng của từng dấu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为图形：添加标志不代表任何认证。请遵守每个标志各自的使用规定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅為圖形：加入標誌不代表任何認證。請遵守各標誌本身的使用規定。"
          }
        }
      }
    },
    "marks_needs_number": {
      "extractionState": "manual",
      "localizations": {
