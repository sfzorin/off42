    "doc_convert_anyway": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\nهل تريد التحويل على أي حال؟ ستُستبعد الأنماط والإعدادات والأجزاء الأخرى التي لا يستطيع %2$@ الاحتفاظ بها، ويُحتفظ بالنص والتنسيق المدعوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\nTrotzdem konvertieren? Formatvorlagen, Einstellungen und andere Teile, die %2$@ nicht aufnehmen kann, entfallen; der Text und die unterstützte Formatierung bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\nConvert anyway? Styles, settings and other parts that %2$@ cannot hold are left out; the text and supported formatting are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\n¿Convertir de todos modos? Se omiten los estilos, los ajustes y otras partes que %2$@ no puede contener; se conservan el texto y el formato compatible."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\nI-convert pa rin? Hindi isasama ang mga style, setting at iba pang bahaging hindi kayang hawakan ng %2$@; mananatili ang text at ang sinusuportahang formatting."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\nConvertir quand même ? Les styles, réglages et autres éléments que %2$@ ne peut pas contenir sont omis ; le texte et la mise en forme prise en charge sont conservés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\nMégis átalakítod? A stílusok, beállítások és egyéb részek, amelyeket a(z) %2$@ nem tud tárolni, kimaradnak; a szöveg és a támogatott formázás megmarad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\nTetap konversi? Gaya, pengaturan, dan bagian lain yang tidak dapat disimpan oleh %2$@ akan dihilangkan; teks dan format yang didukung tetap dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\nConvertire comunque? Stili, impostazioni e altre parti che %2$@ non può contenere vengono omessi; il testo e la formattazione supportata vengono mantenuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。\n\nこのまま変換しますか？ %2$@ で保持できないスタイル、設定などは省かれます。テキストと対応している書式は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\n그래도 변환할까요? %2$@에 담을 수 없는 스타일, 설정 등은 빠지고, 텍스트와 지원되는 서식은 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\nTukar juga? Gaya, tetapan dan bahagian lain yang tidak dapat disimpan oleh %2$@ akan ditinggalkan; teks dan pemformatan yang disokong dikekalkan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\nKonwertować mimo to? Style, ustawienia i inne elementy, których %2$@ nie może przechować, zostaną pominięte; tekst i obsługiwane formatowanie zostaną zachowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\nConverter mesmo assim? Estilos, configurações e outras partes que o %2$@ não comporta serão omitidos; o texto e a formatação compatível são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\nВсё равно конвертировать? Стили, настройки и другие части, которые %2$@ не может хранить, будут опущены; текст и поддерживаемое форматирование сохранятся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nต้องการแปลงต่อหรือไม่ สไตล์ การตั้งค่า และส่วนอื่นๆ ที่ %2$@ เก็บไว้ไม่ได้จะถูกตัดออก ส่วนข้อความและการจัดรูปแบบที่รองรับจะยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\nYine de dönüştürülsün mü? %2$@ biçiminin tutamadığı stiller, ayarlar ve diğer bölümler dışarıda bırakılır; metin ve desteklenen biçimlendirme korunur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@.\n\nVẫn chuyển đổi? Kiểu, thiết lập và các phần khác mà %2$@ không lưu được sẽ bị bỏ qua; văn bản và định dạng được hỗ trợ vẫn được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。\n\n仍要转换吗？%2$@ 无法容纳的样式、设置和其他部分将被舍弃；文本和受支持的格式会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。\n\n仍要轉換嗎？%2$@ 無法容納的樣式、設定和其他部分會被捨棄；文字與支援的格式會保留。"
          }
        }
      }
    },
