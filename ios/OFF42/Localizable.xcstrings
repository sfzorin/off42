          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita ang mga slide bilang text at table; malapit na ang buong pag-render"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les diapositives s’affichent en texte et tableaux ; le rendu complet arrive bientôt"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diák szövegként és táblázatként jelennek meg; a teljes megjelenítés hamarosan érkezik"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide ditampilkan sebagai teks dan tabel; tampilan slide lengkap segera hadir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le diapositive sono mostrate come testo e tabelle; la visualizzazione completa arriverà presto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライドはテキストと表で表示されます。完全な表示は近日対応予定です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬라이드는 텍스트와 표로 표시됩니다. 전체 슬라이드 렌더링은 곧 제공됩니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaid dipaparkan sebagai teks dan jadual; paparan slaid penuh akan datang"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slajdy są pokazane jako tekst i tabele; pełny podgląd pojawi się wkrótce"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os slides aparecem como texto e tabelas; a renderização completa virá em breve"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слайды показаны как текст и таблицы; полноценная отрисовка появится позже"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สไลด์แสดงเป็นข้อความและตาราง การแสดงผลสไลด์เต็มรูปแบบกำลังจะมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaytlar metin ve tablo olarak gösterilir; tam görüntüleme yakında"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang chiếu được hiển thị dạng văn bản và bảng; chế độ hiển thị đầy đủ sắp có"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "幻灯片以文本和表格显示；完整渲染即将推出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
