    "privacy_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح الملفات وتُحوَّل على هذا الجهاز. لا يتصل OFF42 بالشبكة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien werden auf diesem Gerät geöffnet und umgewandelt. OFF42 baut keine Netzwerkverbindungen auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are opened and converted on this device. OFF42 makes no network connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se abren y convierten en este dispositivo. OFF42 no se conecta a la red."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binubuksan at kino-convert ang mga file sa device na ito. Hindi kumokonekta sa network ang OFF42."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont ouverts et convertis sur cet appareil. OFF42 n’établit aucune connexion réseau."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlok megnyitása és átalakítása ezen az eszközön történik. Az OFF42 nem létesít hálózati kapcsolatot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File dibuka dan dikonversi di perangkat ini. OFF42 tidak membuat koneksi jaringan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file vengono aperti e convertiti su questo dispositivo. OFF42 non si connette alla rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはこの端末上で開き、変換されます。OFF42 はネットワークに接続しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 이 기기에서 열리고 변환됩니다. OFF42는 네트워크에 연결하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail dibuka dan ditukar pada peranti ini. OFF42 tidak membuat sambungan rangkaian."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki są otwierane i konwertowane na tym urządzeniu. OFF42 nie łączy się z siecią."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos são abertos e convertidos neste dispositivo. O OFF42 não se conecta à rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы открываются и конвертируются на этом устройстве. OFF42 не подключается к сети."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ถูกเปิดและแปลงบนอุปกรณ์นี้ OFF42 ไม่เชื่อมต่อเครือข่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar bu cihazda açılır ve dönüştürülür. OFF42 ağ bağlantısı kurmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp được mở và chuyển đổi trên thiết bị này. OFF42 không kết nối mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件在本设备上打开和转换。OFF42 不连接网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案在本裝置上開啟與轉換。OFF42 不連線網路。"
          }
        }
      }
    },
