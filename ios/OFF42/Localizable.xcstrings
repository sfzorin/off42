    "no_files": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ملف مفتوح. افتح ملفًا من هنا، أو أرسله إلى OFF42 عبر المشاركة في تطبيق آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Datei geöffnet. Öffnen Sie eine hier oder senden Sie sie in einer anderen App über Teilen an OFF42."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No file open. Open one here, or send one to OFF42 with Share in another app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún archivo abierto. Abre uno aquí o envíalo a OFF42 con Compartir desde otra app."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang bukas na file. Magbukas dito, o ipadala ito sa OFF42 gamit ang Ibahagi sa ibang app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fichier ouvert. Ouvrez-en un ici, ou envoyez-le à OFF42 avec Partager depuis une autre app."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs megnyitott fájl. Nyisson meg egyet itt, vagy küldje el az OFF42-nek egy másik alkalmazás Megosztás funkciójával."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada file yang terbuka. Buka di sini, atau kirim ke OFF42 dengan Bagikan di aplikasi lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun file aperto. Aprine uno qui, oppure invialo a OFF42 con Condividi da un’altra app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているファイルはありません。ここで開くか、他のアプリの共有から OFF42 に送ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열린 파일이 없습니다. 여기서 열거나 다른 앱에서 공유를 사용해 OFF42로 보내세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada fail dibuka. Buka di sini, atau hantar ke OFF42 dengan Kongsi dalam apl lain."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak otwartego pliku. Otwórz go tutaj lub wyślij do OFF42 przez Udostępnij w innej aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum arquivo aberto. Abra um aqui ou envie-o ao OFF42 com Compartilhar em outro app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет открытых файлов. Откройте файл здесь или отправьте его в OFF42 через «Поделиться» в другом приложении."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีไฟล์ที่เปิดอยู่ เปิดไฟล์ที่นี่ หรือส่งไปยัง OFF42 ด้วยการแชร์จากแอปอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık dosya yok. Buradan açın ya da başka bir uygulamada Paylaş ile OFF42’ye gönderin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa mở tệp nào. Mở tệp tại đây, hoặc gửi tệp tới OFF42 bằng Chia sẻ trong ứng dụng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有打开的文件。在此打开，或在其他应用中通过“共享”发送到 OFF42。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有開啟的檔案。在此開啟，或在其他 App 中透過「分享」傳送到 OFF42。"
          }
        }
      }
    },
