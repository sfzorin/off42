    "slides_outline_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعرض الشرائح كنصوص وجداول؛ العرض الكامل للشرائح قادم قريبًا"
          }
        },
        "de": {
