{
  "name": "off42",
  "compatibility_date": "2026-11-06",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/assets/video/*",
      "/api/assistant"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "ASSISTANT_SITE_KEY": "0x4AAAAAAGV3vfoOjrOYhppU",
    "ASSISTANT_DAILY_USD": "5"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ASSISTANT_BUDGET",
        "class_name": "AssistantBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "assistant-budget-v1",
      "new_sqlite_classes": [
        "AssistantBudget"
      ]
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.md"
      ],
      "fallthrough": true
    }
  ]
}
