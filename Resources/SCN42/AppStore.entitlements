<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store variant only (scripts/build-app-store.sh); the DMG build signs without entitlements.
	     $(TEAM_ID) is replaced with APP_STORE_TEAM_ID at signing time. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Documents the user opens, saves or drops on the app. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Security-scoped bookmarks: Open Recent and remembered output folders. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Signatures, stamps, signing keys and shared preferences, used by all six apps. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TEAM_ID).cc.off42</string>
	</array>
	<key>com.apple.security.print</key>
	<true/>
	<!-- USB scanners (ImageCaptureCore). -->
	<key>com.apple.security.device.usb</key>
	<true/>
	<!-- Network and AirPrint scanners found over Bonjour. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Continuity Camera (iPhone/iPad document scans and photos). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Default save folder ~/Downloads/Scans (~/Documents is the container's own folder in the sandbox). -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
